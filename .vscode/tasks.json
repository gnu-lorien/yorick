{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Dev: Full stack (app + Vue client)",
            "dependsOn": [
                "Dev: App + Mongo",
                "Dev: Vue client"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Dev: App + Mongo",
            "type": "shell",
            "command": "node .claude/dev-with-mongo.js",
            "problemMatcher": [],
            "isBackground": true,
            "options": {
                "env": {
                    // parse-server bakes this origin into every Parse.File URL,
                    // and cloud/main.js reads each uploaded portrait BACK over
                    // HTTP from it to build the thumbnails.
                    //
                    // dev-with-mongo.js otherwise points it at the tailnet
                    // hostname, so that a phone can upload. On a desktop that
                    // is a trap: `tailscale serve` on this machine proxies / to
                    // 127.0.0.1:3773, which is the editor, not Yorick. The
                    // readback then fetches HTML, hands it to Jimp, and the
                    // upload fails with "Could not find MIME for Buffer".
                    //
                    // Unset this (and run `tailscale serve --bg 41337`) if you
                    // actually want to reach the dev server from a phone.
                    "PUBLIC_SERVER_URL": "http://localhost:41337/parse/1"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev"
            }
        },
        {
            "label": "Dev: Vue client",
            "type": "shell",
            "command": "npm run dev:vue",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev"
            }
        },
        {
            "label": "Playwright: Open Interactive UI Mode",
            "type": "shell",
            "command": "npx playwright test --ui",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Playwright: Run All E2E Tests",
            "type": "shell",
            "command": "npx playwright test",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Run Character History & XP Tests",
            "type": "shell",
            "command": "npx playwright test e2e/character-history.spec.js",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Run Administration Tests",
            "type": "shell",
            "command": "npx playwright test e2e/administration.spec.js",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Run Troupe Tests",
            "type": "shell",
            "command": "npx playwright test e2e/troupes.spec.js",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Run Character Sheet Tests",
            "type": "shell",
            "command": "npx playwright test e2e/character-sheet.spec.js",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Run Auth & Profile Tests",
            "type": "shell",
            "command": "npx playwright test e2e/auth-profile.spec.js",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Show HTML Report",
            "type": "shell",
            "command": "npx playwright show-report",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
