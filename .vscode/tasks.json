{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Dev: Full stack (app + Vue client)",
            "dependsOn": [
                "Dev: App + Mongo",
                "Dev: Vue client"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Dev: App + Mongo",
            "type": "shell",
            "command": "node .claude/dev-with-mongo.js",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev"
            }
        },
        {
            "label": "Dev: Vue client",
            "type": "shell",
            "command": "npm run dev:vue",
            "problemMatcher": [],
            "isBackground": true,
            "options": {
                "env": {
                    // The https port `tailscale serve` publishes this on, so
                    // Vite tells its HMR client to dial the proxy instead of
                    // its own unreachable 5273. See vite.config.ts and
                    // docs/runbooks/tailscale-dev-environment.md.
                    "YORICK_SERVE_PORT": "8443"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dev"
            }
        },
        {
            "label": "Playwright: Open Interactive UI Mode",
            "type": "shell",
            "command": "npx playwright test --ui",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Playwright: Run All E2E Tests",
            "type": "shell",
            "command": "npx playwright test",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Run Character History & XP Tests",
            "type": "shell",
            "command": "npx playwright test e2e/character-history.spec.js",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Run Administration Tests",
            "type": "shell",
            "command": "npx playwright test e2e/administration.spec.js",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Run Troupe Tests",
            "type": "shell",
            "command": "npx playwright test e2e/troupes.spec.js",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Run Character Sheet Tests",
            "type": "shell",
            "command": "npx playwright test e2e/character-sheet.spec.js",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Run Auth & Profile Tests",
            "type": "shell",
            "command": "npx playwright test e2e/auth-profile.spec.js",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Playwright: Show HTML Report",
            "type": "shell",
            "command": "npx playwright show-report",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
