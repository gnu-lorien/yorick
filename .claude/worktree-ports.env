# Port block for the Vue-migration worktree.
#
# main (C:/prj/yorick) and the React worktree may be running at the same time,
# so nothing here may use the documented defaults: app 41337, mongo 27117,
# E2E base 1337, and 27017/1337-1344 which belong to the E2E workers.
PORT=42337
YORICK_DEV_MONGO_PORT=27237
YORICK_DEV_DB=yorick_dev_vue
YORICK_DEV_DBPATH=${HOME}/.yorick-dev-mongo-vue/data
E2E_BASE_PORT=2337
VITE_PORT=5273
