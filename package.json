{
  "name": "yorick",
  "version": "0.9.0",
  "author": "Andrew Sayman <andrew.sayman@gmail.com>",
  "description": "A Vampire and Werewolf character database for By Night Studios Mind's Eye Theater (BNS MET)",
  "license": "AGPL-3.0",
  "main": "public/index.html",
  "window": {
    "toolbar": false,
    "width": 1024,
    "height": 600,
    "icon": "rsrc/img/logo.ico"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "body-parser": "^1.18.3",
    "cors": "^2.8.4",
    "express": "^4.16.3",
    "jimp": "^0.22.12",
    "lodash": "^4.17.10",
    "moment": "^2.22.2",
    "mongodb": "7.1.0",
    "parse": "8.6.0",
    "parse-server": "=9.10.0",
    "paypal-ipn": "^3.0.0",
    "serve-static": "^1.13.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "gulp": "^4.0.0",
    "gulp-clean": "^0.3.2",
    "gulp-debug": "^2.1.2",
    "gulp-htmlmin": "^2.0.0",
    "gulp-minify-css": "^1.2.4",
    "gulp-replace": "^0.5.4",
    "gulp-uglify": "^1.5.3",
    "jasmine-core": "~3.8.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "~4.0.2",
    "karma-requirejs": "~1.1.0",
    "mongodb-memory-server": "^11.2.0",
    "nodefy": "^0.2.2",
    "requirejs": "^2.2.0",
    "url-search-params": "^0.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gnu-lorien/yorick.git"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0 || >=22.13.0 <23.0.0 || >=24.11.0 <25.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "seed": "node -e \"require('./seed_db').seedDatabase(process.env.MONGODB_URI || 'mongodb://localhost:27017/anotherstore', { force: true }).then(() => console.log('Database seeded successfully')).catch(console.error)\"",
    "audit-permissions": "node audit_db_permissions.js",
    "test:node": "node --test test/*.test.js",
    "test:diff": "node diff-runs.js",
    "hook-counts": "node hook-counts.js",
    "gate": "node gate.js",
    "test": "node test_runner.js localhost",
    "test:localhost": "node test_runner.js localhost",
    "test:staging": "karma start public/karma.conf.js --single-run --target=staging",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --project=admin",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "pretest:e2e": "node e2e/check-syntax.js",
    "test:e2e:syntax": "node e2e/check-syntax.js",
    "test:e2e:main": "playwright test --project=chromium",
    "test:e2e:patronage": "playwright test e2e/admin-patronage.spec.js",
    "test:e2e:rules": "playwright test e2e/admin-rules.spec.js",
    "test:e2e:referendums": "playwright test e2e/admin-referendums.spec.js",
    "test:e2e:xp": "playwright test e2e/xp-history.spec.js",
    "test:e2e:approvals": "playwright test e2e/approvals.spec.js",
    "test:e2e:assets": "playwright test e2e/assets-rename-portrait.spec.js",
    "test:e2e:troupes": "playwright test e2e/troupes.spec.js",
    "test:e2e:creation": "playwright test e2e/creation-vampire.spec.js e2e/creation-werewolf.spec.js e2e/creation-changeling.spec.js",
    "test:e2e:traits": "playwright test e2e/traits-lifecycle.spec.js",
    "test:e2e:longtexts": "playwright test e2e/long-texts.spec.js",
    "test:e2e:descriptions": "playwright test e2e/descriptions-by-creature.spec.js",
    "test:e2e:lifecycle": "playwright test e2e/lifecycle-vampire.spec.js e2e/lifecycle-werewolf.spec.js e2e/lifecycle-changeling.spec.js",
    "test:e2e:access": "playwright test e2e/access-control.spec.js"
  }
}
