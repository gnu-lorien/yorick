{
  "name": "yorick",
  "version": "0.9.0",
  "author": "Andrew Sayman <andrew.sayman@gmail.com>",
  "description": "A Vampire and Werewolf character database for By Night Studios Mind's Eye Theater (BNS MET)",
  "license": "AGPL-3.0",
  "main": "public/index.html",
  "window": {
    "toolbar": false,
    "width": 1024,
    "height": 600,
    "icon": "rsrc/img/logo.ico"
  },
  "dependencies": {
    "body-parser": "^1.18.3",
    "cors": "^2.8.4",
    "express": "^4.16.3",
    "jimp": "^0.2.28",
    "lodash": "^4.17.10",
    "moment": "^2.22.2",
    "parse": "^1.9.0",
    "parse-server": "=2.8.4",
    "parse-server-nodemailer-adapter": "^1.0.0",
    "paypal-ipn": "^3.0.0",
    "request": "^2.87.0",
    "require": "*",
    "serve-static": "^1.13.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "gulp": "^4.0.0",
    "gulp-clean": "^0.3.2",
    "gulp-debug": "^2.1.2",
    "gulp-htmlmin": "^2.0.0",
    "gulp-minify-css": "^1.2.4",
    "gulp-replace": "^0.5.4",
    "gulp-uglify": "^1.5.3",
    "jasmine-core": "~3.8.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "~4.0.2",
    "karma-phantomjs-launcher": "^1.0.4",
    "karma-requirejs": "~1.1.0",
    "mongodb-memory-server": "^11.2.0",
    "nodefy": "^0.2.2",
    "phantomjs-prebuilt": "^2.1.7",
    "requirejs": "^2.2.0",
    "url-search-params": "^0.6.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gnu-lorien/yorick.git"
  },
  "scripts": {
    "start": "node index.js",
    "seed": "node -e \"require('./seed_db').seedDatabase(process.env.MONGODB_URI || 'mongodb://localhost:27017/anotherstore').then(() => console.log('Database seeded successfully')).catch(console.error)\"",
    "audit-permissions": "node audit_db_permissions.js",
    "test": "node test_runner.js localhost",
    "test:localhost": "node test_runner.js localhost",
    "test:staging": "karma start public/karma.conf.js --single-run --browsers PhantomJS --target=staging",
    "test:e2e": "playwright test",
    "test:e2e:history": "playwright test e2e/character-history.spec.js",
    "test:e2e:admin": "playwright test e2e/administration.spec.js",
    "test:e2e:troupe": "playwright test e2e/troupes.spec.js",
    "test:e2e:sheet": "playwright test e2e/character-sheet.spec.js",
    "test:e2e:auth": "playwright test e2e/auth-profile.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  }
}
